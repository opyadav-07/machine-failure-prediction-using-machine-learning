   "source": [
    "**HYPERPARAMETER TUNING:**"
   ],
   "metadata": {
    "id": "vocnsoJR9Ebi"
   }
  },
  {
   "cell_type": "code",
   "source": [
    "from sklearn.model_selection import GridSearchCV, StratifiedKFold"
   ],
   "metadata": {
    "id": "XfQ_PmbVNUT3"
   },
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "source": [
    "# Calculate imbalance ratio from training data only\n",
    "negative_count = (y_train == 0).sum()\n",
    "positive_count = (y_train == 1).sum()\n",
    "\n",
    "scale_pos_weight = negative_count / positive_count\n",
    "\n",
    "cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)"
   ],
   "metadata": {
    "id": "bE8_g3wdAyHj"
   },
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "markdown",
   "source": [
    "GridSearchCV for XGBoost"
   ],
   "metadata": {
    "id": "GuuQNeCjBsmG"
   }
  },
  {
   "cell_type": "code",
   "source": [
    "XGB = XGBClassifier(\n",
    "    objective='binary:logistic',\n",
    "    eval_metric='logloss',\n",
    "    scale_pos_weight=scale_pos_weight,\n",
    "    random_state=42,\n",
    "    n_jobs=1)\n",
    "\n",
    "xgb_params = {\n",
    "    'n_estimators': [100, 200],\n",
    "    'max_depth': [3, 5],\n",
    "    'learning_rate': [0.05, 0.1],\n",
    "    'subsample': [0.8, 1.0]\n",
    "}\n",
    "\n",
    "xgb_grid = GridSearchCV(\n",
    "    estimator=XGB,\n",
    "    param_grid=xgb_params,\n",
    "    scoring='average_precision',\n",
    "    cv=cv,\n",
    "    verbose=1,\n",
    "    n_jobs=-1,)\n",
    "\n",
    "\n",
    "xgb_grid.fit(X, y)\n",
    "result_xgb_grid = pd.DataFrame(xgb_grid.cv_results_)\n",
    "\n",
    "\n",
    "print(\"Best XGBoost Parameters:\")\n",
    "print(xgb_grid.best_params_)\n",
    "\n",
    "print(\"\\nBest XGBoost CV PR-AUC:\")\n",
    "print(round(xgb_grid.best_score_, 4))\n"
   ],
